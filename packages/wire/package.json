{
  "name": "@sintetizing/wire",
  "version": "1.0.0",
  "description": "Deterministic binary envelope and TLV serialization engine for Sintetize P2P",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simular": "npx tsx scripts/simulate-network.ts",
    "simular:rapido": "npx tsx scripts/simulate-network.ts --fast",
    "estresse": "npx tsx scripts/stress-test.ts",
    "painel": "npx tsx scripts/serve-dashboard.ts",
    "rede:criar": "npx tsx scripts/build-local-network.ts",
    "inspecionar": "npx tsx scripts/inspect-packet.ts",
    "arvore": "npx tsx scripts/tree-stze.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
